{
  "name": "glossa",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source localization infrastructure — build once, speak everywhere",
  "license": "MIT",
  "author": "Felix Geelhaar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarlabs-studio/glossa.git"
  },
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "vite@6": "^6.4.4",
      "vite@8": "^8.3.3",
      "dompurify": "^3.4.17",
      "undici": "^8.12.2",
      "zod": "^4.6.6",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  },
  "dependencies": {
    "@vitest/mocker": "^4.1.11"
  }
}
