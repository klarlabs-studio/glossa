      "orphaned": {
        "id": "orphaned",
        "type": "atomic",
        "transitions": [{ "event": "approval.granted", "target": "done" }]
      },
      "done": { "id": "done", "type": "final" }
    }
  },
  "guards": {},
  "actions": {
    "approve": { "use": "set_review_state", "state": "approved" }
  }
}
