# syntax=docker/dockerfile:1.10
#
# glossa-edge: the stateless delivery plane (RFC 0002 §3). It reads object
# storage and nothing else; no database driver is linked in.
#
# Build from the repository root; platform/go.mod replaces messageformat
# and runtimes/go with the in-repo modules:
#
#   docker build -f platform/Dockerfile.edge -t glossa-edge .
#
# Base images are pinned by digest. Bump the tag and the digest together
# (`docker buildx imagetools inspect <image>:<tag>` prints the index digest).

ARG GO_IMAGE=golang:1.26-alpine@sha256:51a7c389a5ddaf82f527191a1e9bff9928655130a44e4975dd1d7e0acf59f1ae
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

# ── Build ────────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG TARGETOS
ARG TARGETARCH
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath
WORKDIR /src

COPY messageformat/go.mod messageformat/go.sum messageformat/
COPY runtimes/go/go.mod runtimes/go/go.sum runtimes/go/
COPY platform/go.mod platform/go.sum platform/
WORKDIR /src/platform
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY messageformat/ /src/messageformat/
COPY runtimes/go/ /src/runtimes/go/
COPY platform/ /src/platform/
# The release version and source revision, linked into the binary so
# `-version` and the startup log report them (kernel/buildinfo, #65).
# Declared here, not at the top of the stage, so a new version does not
# invalidate the cached module download.
ARG VERSION=dev
ARG REVISION=unknown
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -buildvcs=false \
      -ldflags="-s -w -X go.klarlabs.de/glossa/platform/internal/kernel/buildinfo.version=${VERSION} -X go.klarlabs.de/glossa/platform/internal/kernel/buildinfo.revision=${REVISION}" \
      -o /out/glossa-edge ./cmd/glossa-edge

# ── Runtime ──────────────────────────────────────────────────────────
# distroless/static, nonroot (65532), read-only root filesystem friendly:
# the edge keeps its cache in memory.
#
# No HEALTHCHECK: the image has no HTTP client to run one, and Kubernetes
# ignores it anyway. The chart probes GET /livez and GET /readyz on :8081.
FROM ${RUNTIME_IMAGE}
ARG VERSION=dev
ARG REVISION=unknown
ARG CREATED=""
LABEL org.opencontainers.image.title="glossa-edge" \
      org.opencontainers.image.description="Glossa delivery plane: serves signed release manifests and artifacts from object storage." \
      org.opencontainers.image.source="https://github.com/klarlabs-studio/glossa" \
      org.opencontainers.image.url="https://github.com/klarlabs-studio/glossa/tree/main/platform" \
      org.opencontainers.image.documentation="https://github.com/klarlabs-studio/glossa/blob/main/platform/README.md" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Klarlabs" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}"
COPY --from=build /out/glossa-edge /usr/local/bin/glossa-edge
USER 65532:65532
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/glossa-edge"]
